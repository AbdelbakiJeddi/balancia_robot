<?xml version="1.0"?>
<robot name="diffdrive_rl_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ BASE / CHASSIS ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.07 0.1" />
      </geometry>
      <material name="chassis_color">
        <color rgba="0.2 0.2 0.8 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.07 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.00248333" ixy="0.0" ixz="0.0"
        iyy="0.00208333" iyz="0.0"
        izz="0.00123333" />
    </inertial>
  </link>

  <!-- ============ LEFT WHEEL ============ -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="6.66667e-6" ixy="0.0" ixz="0.0"
        iyy="1.0e-5" iyz="0.0"
        izz="6.66667e-6" />
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0.0 0.045 -0.045" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.02" friction="0.01" />
  </joint>

  <!-- ============ RIGHT WHEEL ============ -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="6.66667e-6" ixy="0.0" ixz="0.0"
        iyy="1.0e-5" iyz="0.0"
        izz="6.66667e-6" />
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0.0 -0.045 -0.045" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.02" friction="0.01" />
  </joint>

</robot>